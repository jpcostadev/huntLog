{
  "expo": {
    "name": "HuntLog Tibia",
    "slug": "huntlog-tibia",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/huntlog-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.huntlog.tibia",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#080D14",
      "adaptiveIcon": {
        "backgroundColor": "#080D14",
        "foregroundImage": "./assets/huntlog-android-foreground.png",
        "backgroundImage": "./assets/huntlog-android-background.png",
        "monochromeImage": "./assets/huntlog-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/huntlog-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "93d91353-ab5d-491d-913f-80b43c1049cd"
      }
    }
  }
}
